 "poems": [
  {
   "seq": "1",
   "text": "降雪のみのしろ衣うちきつゝ春きにけりとおとろかれぬる",
   "kana": "",
   "speaker": "敏行朝臣集",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "老ぬ迚なとて我みをせめきけんおいすはけふにあはまし物か",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "玉たれのこかめやいつらこゆるきの磯の波わけ沖に出にけり",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "いくはくの田をつくれはか時鳥してのたをさを朝な〓〓よふ",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "明ぬとてかへる道にはこきたれて雨も泪も降にこそふれ",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "千はやふるかもの社の姫小松よろつよまても色はかはらし",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "つれ〓〓のなかめにまさる淚川袖のみぬれてあふよしもなし",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "我〓とく物や戀しきほとゝきすときそともなく夜たゝ鳴らん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "こひ侘てうちぬる中に行かよふ夢のたゝちはうつゝならなん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "我きつる方もしられすくらま山やまの木葉のちるとまかふに",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "久方の雲のうへにてみるきくは天津ほしとそあやまたれける",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "何人かきてぬきかけし藤はかまくる秋〓とに野へをにほはす",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "秋の野に宿りはすへし女郞花名をむつましみ旅ならなくに",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "秋きぬとめにはさやかにみえねとも風の音にそ驚かれぬる",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "秋の夜のあくるもしらす鳴虫はわかと物や悲しかるらん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "秋はきの花咲にけり高砂の尾上の鹿は今やなくらん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "我戀の數をかそへは天の原雲ゐはるかに降雨のこと",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "あふ坂のゆふつけに鳴鳥のねはきゝとかめてそ行過にける",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "大空に雲のかりかねきにけらしおのかとこにはなしの宿りに",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "秋たちていくかもあらぬにこのねぬる朝けの風は袂すゝしも",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "いつことも草の枕を鈴虫はこゝをたひとは思はさらなん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "春雨の花の枝よりなかれこはぬれ社ぬれめなにかかくれん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "しら露の色はひとつをいかにして秋の山へをちゝにそむらん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "心から花の雫にそほちつゝうぐひすとのみ鳥のなくらん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
